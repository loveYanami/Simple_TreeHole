# 复制为 .env.local 后生效（.env.local 已被 gitignore）。
# 这两个变量都能留空 —— 留空时使用下面注释里写的默认值。

# mock 层模拟的网络延时（毫秒），默认 300。
# 想快速点完整个流程可以把 0 填进去，页面就不会有等待感。
VITE_MOCK_LATENCY_MS=300

# mock 层默认失败率（0~1），默认 0。
# 刻意默认为 0：演示和评审时不该撞上随机失败。
# 想展示错误分支（toast、回滚）时临时调成 0.3 即可，也可以不改这里，
# 直接在执行期间用 localStorage['treehole:chaos'] = '0.3' 注入。
VITE_MOCK_FAIL_RATE=0
